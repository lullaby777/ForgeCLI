-"""Tool registry."""
+"""Tool registry.
+
+The built-in tools are stateless except for two the framework owns: the task
+list (todo_write) and the sub-agent handle (agent). Sharing one instance of
+those across agents would leak a checklist from one agent into another's
+system prompt and re-point a sub-agent tool at whichever agent was built
+last, so a default agent gets its own freshly built set (see
+``default_tools``). ``ALL_TOOLS`` stays as the canonical shared registry for
+callers that want the plain objects.
+"""
 
 from .agent import AgentTool
+from .base import Tool
 from .bash import BashTool
 from .edit import EditFileTool
+from .fetch import FetchUrlTool
 from .glob_tool import GlobTool
 from .grep import GrepTool
+from .now import NowTool
 from .read import ReadFileTool
 from .todo import TodoWriteTool
 from .write import WriteFileTool
-from .now import NowTool
-from .fetch import FetchUrlTool
 
-ALL_TOOLS = [
-    BashTool(),
-    ReadFileTool(),
-    WriteFileTool(),
-    EditFileTool(),
-    GlobTool(),
-    GrepTool(),
-    TodoWriteTool(),
-    AgentTool(),
-    NowTool(),
-    FetchUrlTool(),
+# One entry per built-in capability, in the order they are offered to the model.
+_TOOL_TYPES = [
+    BashTool,
+    ReadFileTool,
+    WriteFileTool,
+    EditFileTool,
+    GlobTool,
+    GrepTool,
+    TodoWriteTool,
+    AgentTool,
+    NowTool,
+    FetchUrlTool,
 ]
 
+
+def default_tools() -> list[Tool]:
+    """A brand-new set of built-in tools for a single agent.
+
+    Every call builds fresh instances, so per-agent state (the task list, the
+    sub-agent's parent link) can never be shared between agents.
+    """
+    return [tool_type() for tool_type in _TOOL_TYPES]
+
+
+ALL_TOOLS = default_tools()
