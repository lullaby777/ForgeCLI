+def _file_newline(text: str) -> str:
+    """Return the file's uniform newline, or LF when it is not uniform.
+
+    Only all-CRLF and all-LF files are in scope; anything mixed (or CR-only)
+    falls back to LF, where the text is used verbatim instead of being
+    rewritten to some other style.
+    """
+    crlf = text.count("\r\n")
+    if crlf and crlf == text.count("\n"):
+        return "\r\n"
+    return "\n"
+
+
+def _to_lf(text: str) -> str:
+    """Normalise CRLF to LF so matching is newline-style agnostic."""
+    return text.replace("\r\n", "\n")
