+def _is_valid_message(message: object) -> bool:
+    """A message must be an object with a non-empty str role.
+
+    ``content`` is optional, but when present it has to be a str or null
+    (assistant turns with tool_calls legitimately carry ``content: None``).
+    """
+    if not isinstance(message, dict):
+        return False
+
+    role = message.get("role")
+    if not isinstance(role, str) or not role:
+        return False
+
+    if "content" in message:
+        content = message["content"]
+        if content is not None and not isinstance(content, str):
+            return False
+
+    return True
+
+
+def _validate_session_data(data: object) -> tuple[list[dict], str] | None:
+    """Return ``(messages, model)`` for a well-formed session, else None.
+
+    A valid session has an object at the top level, a non-empty string model
+    and a list of well-formed messages (an empty list is fine).
+    """
+    if not isinstance(data, dict):
+        return None
+
+    model = data.get("model")
+    if not isinstance(model, str) or not model:
+        return None
+
+    messages = data.get("messages")
+    if not isinstance(messages, list):
+        return None
+
+    if not all(_is_valid_message(m) for m in messages):
+        return None
+
+    return messages, model
+
+
+def _session_preview(messages: list[dict]) -> str:
+    """First non-empty user message, truncated - used by ``/sessions``."""
+    for message in messages:
+        if message.get("role") == "user" and message.get("content"):
+            return message["content"][:80]
+    return ""
+
+
