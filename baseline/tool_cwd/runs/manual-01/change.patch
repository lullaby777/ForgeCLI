diff --git a/corecoder/tools/base.py b/corecoder/tools/base.py
index f62aeab..4ed37ea 100644
--- a/corecoder/tools/base.py
+++ b/corecoder/tools/base.py
@@ -1,13 +1,38 @@
 """Base class for all tools."""
 
+import os
 import threading
 from abc import ABC, abstractmethod
+from pathlib import Path
 
 # File-mutating tools (write_file/edit_file) serialize on this, so a parallel
 # batch can't interleave read-modify-write on the same file and lose an edit.
 FILE_MUTATION_LOCK = threading.Lock()
 
 
+def resolve_tool_path(path: str) -> Path:
+    """Resolve a tool's path argument against the session's working directory.
+
+    The bash tool tracks the directory the session is "in" thread-locally, so
+    the file tools have to agree with it: a relative path means "relative to
+    where the session is now", not "relative to wherever the Python process
+    happens to have been started". Absolute paths and ``~`` keep their usual
+    meaning, and a session with no recorded directory falls back to the
+    process cwd, exactly like bash does.
+
+    Resolving per call (instead of ``os.chdir``) keeps threads, parallel tool
+    batches and sub-agents isolated from each other.
+    """
+    p = Path(path).expanduser()
+    if p.is_absolute():
+        return p.resolve()
+    # imported lazily: bash.py imports this module at import time
+    from .bash import get_tracked_cwd
+
+    base = get_tracked_cwd() or os.getcwd()
+    return (Path(base) / p).resolve()
+
+
 class Tool(ABC):
     """Minimal tool interface. Subclass this to add new capabilities."""
 
