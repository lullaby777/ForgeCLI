+def _normalize_lf(text: str) -> tuple[str, list[int]]:
+    """Collapse CRLF to LF and keep a map back to raw character offsets.
+
+    ``offsets[i]`` is the raw offset of normalized character ``i``, with one
+    extra trailing entry for the end of the text. The map is what lets a match
+    found in the normalized copy be applied to the raw string, so every byte
+    outside the edited span survives untouched.
+    """
+    if "\r\n" not in text:
+        return text, list(range(len(text) + 1))
+
+    normalized: list[str] = []
+    offsets: list[int] = []
+    i, n = 0, len(text)
+    while i < n:
+        offsets.append(i)
+        if text[i] == "\r" and i + 1 < n and text[i + 1] == "\n":
+            normalized.append("\n")
+            i += 2
+        else:
+            normalized.append(text[i])
+            i += 1
+    offsets.append(n)
+    return "".join(normalized), offsets
+
