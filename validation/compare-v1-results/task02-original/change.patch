+def _normalize_newlines(text: str) -> str:
+    """Collapse CRLF (and lone CR) to LF: the form used for matching/diffs."""
+    return text.replace("\r\n", "\n").replace("\r", "\n")
+
+
+def _detect_newline(text: str) -> str:
+    """The file's own newline style: CRLF, lone CR, or plain LF."""
+    if "\r\n" in text:
+        return "\r\n"
+    if "\r" in text:
+        return "\r"
+    return "\n"
+
+
+def _original_span(text: str, start: int, length: int) -> tuple[int, int]:
+    """Map an LF-normalized [start, start+length) range back onto text.
+
+    Inverse of ``_normalize_newlines``: a CRLF pair occupies one normalized
+    character but two characters in the file, so the file-side end can be one
+    byte past the same offset.
+    """
+    i = j = 0
+    orig_start: int | None = None
+    while i < len(text):
+        if j == start:
+            orig_start = i
+        if j == start + length:
+            return (orig_start if orig_start is not None else i), i
+        i += 2 if text[i] == "\r" and text.startswith("\r\n", i) else 1
+        j += 1
+    end = orig_start if orig_start is not None else len(text)
+    return end, len(text)
+
+
