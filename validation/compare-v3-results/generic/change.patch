+def _make_cwd_probe() -> str | None:
+    """Reserve an empty file for the shell's final-directory report.
+
+    The file is created with O_EXCL, so the name is provably ours and the
+    cleanup can only ever unlink this one file — never somebody else's
+    directory, however TMPDIR is patched. No writable temp dir means no probe
+    and the static scan stays in charge.
+    """
+    for _ in range(100):
+        path = os.path.join(
+            tempfile.gettempdir(), f"corecoder-cwd-{os.getpid()}-{next(_probe_seq)}"
+        )
+        try:
+            os.close(os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600))
+        except FileExistsError:
+            continue
+        except OSError:
+            return None
+        return path
+    return None
+
+
+def _drop_cwd_probe(probe: str | None) -> None:
+    if not probe:
+        return
+    try:
+        os.unlink(probe)
+    except OSError:
+        pass
+
+
+def _with_cwd_probe(command: str, probe_path: str) -> str:
+    """Append a trailing probe that records where this very shell ended up.
+
+    It runs in the same shell and after the whole chain, so `&&` short-circuits,
+    `;` leftovers, subshell parentheses and quoting are all decided by the shell
+    itself instead of being guessed. The directory is written to a file (never
+    to stdout), and the shell then exits with the command's own status so a
+    failure still reads as `[exit code: N]`.
+    """
+    return "\n".join([
+        command,
+        "__corecoder_status=$?",
+        f"pwd > {shlex.quote(probe_path)}",
+        "exit $__corecoder_status",
+    ])
+
+
+def _read_cwd_probe(probe_path: str | None) -> str | None:
+    """The directory the shell reported, or None if it never got to write one."""
+    if not probe_path:
+        return None
+    try:
+        with open(probe_path, encoding="utf-8", errors="replace") as fh:
+            reported = fh.read().strip()
+    except OSError:
+        return None
+    # a report that is not a real directory (a foreign path form, a dir deleted
+    # mid-command) is no better than no report at all
+    return reported if reported and os.path.isdir(reported) else None
 
 
