+        f"{{\n:\n{command}\n}}\n"
+        f"{_REPORT_VAR}=$?\n"
+        f"pwd > {_quote_shell_path(report)} 2>/dev/null\n"
+        f"exit ${_REPORT_VAR}\n"
+    )
