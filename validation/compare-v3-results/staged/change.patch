+def _wrap_with_cwd_report(command: str, report: str) -> str:
+    """Run `command`, then record the directory this shell really ended in.
+
+    `{ ... }` is a plain group, not a subshell, so a `cd` inside it moves this
+    shell exactly as it would at top level - even when a later command in the
+    chain fails. The leading `:` keeps the group non-empty (comments-only
+    commands still parse) and the trailing `exit` forwards the command's own
+    status untouched, so the caller's view of the run does not change.
+    """
