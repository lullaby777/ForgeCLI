+def _read_cwd_report(report: str) -> str | None:
+    """The path the shell recorded, or None if it stopped before reporting
+    (timeout, explicit `exit`, killed process)."""
+    try:
+        with open(report, encoding="utf-8", errors="replace") as fh:
+            lines = [line.strip() for line in fh.read().splitlines()]
+    except OSError:
+        return None
+    return next((line for line in reversed(lines) if line), None)
