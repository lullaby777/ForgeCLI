+# --- real-shell cwd tracking ------------------------------------------------
+#
+# Reading cd's out of the command line can only ever be a guess: `false && cd a`
+# and `cd a && false` look alike, a cd inside quotes is not a command, and a cd
+# inside `( ... )` never moves this shell. The exit status does not help either:
+# `cd sub && false` fails *after* the cd landed. So the shell tells us itself.
+
+def _new_cwd_report_dir() -> str | None:
+    """Scratch directory the wrapped shell will drop its final `pwd` into.
+
+    A fresh directory (rather than a pre-created file) means a stale answer can
+    never be mistaken for this run's answer: no file ⇒ the shell never got that
+    far, which is exactly what timeout/`exit` look like.
+    """
+    try:
+        return tempfile.mkdtemp(prefix="corecoder-cwd-")
+    except OSError:
+        return None
+
+
+def _with_cwd_report(command: str, report_file: str) -> str:
+    """Append a postamble that writes the shell's final directory to a file.
+
+    The postamble runs in the same shell process as the user's command, so every
+    cd that really executed is reflected and every skipped one is not. It then
+    exits with the user's own status, so stdout/stderr and the exit code come
+    back untouched, and `pwd`'s answer goes to a scratch file instead of the
+    output the user sees. Placed on its own lines so a trailing `# comment`
+    cannot swallow it; `set +x` is silenced first so an active `set -x` does not
+    echo these internal lines into stderr.
+    """
+    return (
+        f"{command}\n"
+        "__corecoder_cwd_status=$?\n"
+        "{ set +x; } 2>/dev/null\n"
+        f"pwd > {shlex.quote(report_file)} 2>/dev/null\n"
+        "exit $__corecoder_cwd_status\n"
+    )
+
+
+def _read_cwd_report(report_file: str | None) -> str | None:
+    """The directory the shell reported, or None if it never reported one."""
+    if report_file is None:
+        return None
+    try:
+        with open(report_file, encoding="utf-8", errors="replace") as fh:
+            reported = fh.read().strip()
+    except OSError:
+        return None
+    # a directory name may contain newlines; the last line is the tail of it
+    return reported.splitlines()[-1] if reported else None
+
+
+def _remember_cwd(reported: str, previous: str) -> None:
+    """Record the shell's final directory for this thread, if it really moved."""
+    if _same_dir(reported, previous):
+        return
+    _local.cwd = os.path.normpath(reported)
+
+
+def _same_dir(a: str, b: str) -> bool:
+    """True when two paths name the same directory (symlinks included)."""
+    if os.path.normpath(a) == os.path.normpath(b):
+        return True
+    try:
+        return os.path.samefile(a, b)
+    except OSError:
+        return False
+
