+def _reserve_cwd_probe() -> str | None:
+    """Reserve an empty file the wrapped shell can drop its final dir into."""
+    if os.name == "nt":
+        # git-bash reports `/c/...` mount paths that Python cannot chdir into, so
+        # Windows keeps the parser-based tracking above untouched
+        return None
+    try:
+        fd, path = tempfile.mkstemp(prefix="corecoder-cwd-")
+    except OSError:
+        return None
+    os.close(fd)
+    return path
+
+
+def _wrap_with_cwd_probe(command: str, probe_path: str) -> str:
+    """Run `command` in this shell, then record where the shell ended up.
+
+    The `pwd` runs *after* the user's statements in the same shell, so it
+    reports the directory that was really reached: `cd sub && false` fails as a
+    whole yet did move the shell, and `false && cd sub; true` succeeds without
+    ever running its `cd`. Parsing the command text cannot tell those apart, and
+    the process exit status cannot either.
+
+    The report goes to a private file — never to stdout/stderr — and the user's
+    exit status is passed through unchanged, so output, truncation and the
+    `[exit code: N]` suffix all keep their old shape.
+    """
+    return (
+        "{\n"
+        f"{command}\n"
+        "}\n"
+        "__corecoder_status=$?\n"
+        f"{{ command pwd > {shlex.quote(probe_path)} 2>/dev/null; }} || true\n"
+        "exit $__corecoder_status\n"
+    )
+
+
+def _read_cwd_probe(probe_path: str | None) -> str | None:
+    """The dir the shell reported, or None when the probe did not run."""
+    if probe_path is None:
+        return None
+    try:
+        with open(probe_path, encoding="utf-8", errors="replace") as f:
+            reported = f.read().strip()
+    except OSError:
+        return None
+    # an empty file means the shell never got that far (killed, `exec`, ...)
+    if not reported or "\n" in reported or not os.path.isabs(reported):
+        return None
+    if not os.path.isdir(reported):
+        return None
+    return os.path.normpath(reported)
+
+
+def _discard_cwd_probe(probe_path: str | None) -> None:
+    if probe_path is None:
+        return
+    try:
+        os.unlink(probe_path)
+    except OSError:
+        pass
 
 
